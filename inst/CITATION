## Citation for the dampack R package. Built from the DESCRIPTION file, so the authors,
## title, and version stay current. Once the JOSS article is published, add its entry here.
pub_date <- meta$`Date/Publication`
year <- if (is.null(pub_date)) format(Sys.Date(), "%Y") else substr(pub_date, 1, 4)
authors <- eval(parse(text = meta$`Authors@R`))
authors <- authors[vapply(seq_along(authors), function(i) "aut" %in% authors[[i]]$role, logical(1))]

bibentry(
  bibtype = "Manual",
  title   = paste0(meta$Package, ": ", meta$Title),
  author  = authors,
  year    = year,
  note    = paste("R package version", meta$Version),
  url     = "https://github.com/DARTH-git/dampack"
)
