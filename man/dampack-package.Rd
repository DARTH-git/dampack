\title{dampack: Decision-Analytic Modeling Package}
\description{
\code{dampack} analyzes and visualizes the health economic outputs of
decision-analytic models. It works on the outputs of any model, whatever
language or framework produced them: a vector of costs and effects for a
base-case cost-effectiveness analysis, or a probabilistic sensitivity
analysis (PSA) with the cost, effect, and parameter values of each sample.
}
\section{Main functions}{

\describe{
\item{Cost-effectiveness analysis}{\code{\link[=calculate_icers]{calculate_icers()}} identifies
dominated and extendedly dominated strategies and computes incremental
cost-effectiveness ratios (ICERs) along the efficient frontier;
\code{\link[=calculate_icers_psa]{calculate_icers_psa()}} does the same from a PSA, with uncertainty
intervals. Results have \code{print()} and \code{plot()} methods.}
\item{PSA objects}{\code{\link[=make_psa_obj]{make_psa_obj()}} builds a \code{psa} object from model
outputs, with \code{summary()} and \code{plot()} methods for the cost-effectiveness
plane.}
\item{Decision uncertainty}{\code{\link[=ceac]{ceac()}} computes cost-effectiveness
acceptability curves and the acceptability frontier; \code{\link[=calc_exp_loss]{calc_exp_loss()}}
computes expected loss curves.}
\item{Value of information}{\code{\link[=calc_evpi]{calc_evpi()}}, \code{\link[=calc_evppi]{calc_evppi()}}, and
\code{\link[=calc_evsi]{calc_evsi()}} compute the expected value of perfect, partial perfect, and
sample information; \code{\link[=metamodel]{metamodel()}} fits the regression metamodels they
rely on.}
\item{Deterministic sensitivity analysis}{\code{\link[=run_owsa_det]{run_owsa_det()}} and
\code{\link[=run_twsa_det]{run_twsa_det()}} run one-way and two-way sensitivity analyses on a
user-supplied model; \code{\link[=owsa]{owsa()}} and \code{\link[=twsa]{twsa()}} derive them from a PSA. Plot
them with \code{plot()}, \code{\link[=owsa_tornado]{owsa_tornado()}}, and \code{\link[=owsa_opt_strat]{owsa_opt_strat()}}.}
\item{Generating a PSA}{\code{\link[=gen_psa_samp]{gen_psa_samp()}} draws parameter samples from
common distributions (with helpers such as \code{\link[=beta_params]{beta_params()}} and
\code{\link[=gamma_params]{gamma_params()}} for method-of-moments parameters), and \code{\link[=run_psa]{run_psa()}} runs
a user-supplied model over them.}
}
